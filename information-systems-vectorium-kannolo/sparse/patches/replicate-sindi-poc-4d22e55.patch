@@ -28,11 +28,20 @@ import numpy as np
 
 
 def load_gt_bin(path: Path) -> tuple[np.ndarray, np.ndarray]:
+    """Ids and **similarities** from a generate_gt .bin.
+
+    vsag stores inner product as a *distance*, i.e. negated: a bin entry of -20.98 is the same
+    quantity the shipped TSV writes as +20.98. Returning the raw value made the score-divergence
+    statistic below compare `-s` against `+s`, so it reported `2s` -- on NQ, "mean=4.297e+01" for
+    scores whose mean magnitude is ~21. That number could never be small, so the one statistic
+    meant to detect a lossy CSR encoding was incapable of detecting anything. Negated here, at
+    the read, so every caller gets the comparable quantity (2026-09-14).
+    """
     with path.open("rb") as f:
         n, k = struct.unpack("<II", f.read(8))
         ids = np.fromfile(f, dtype="<i4", count=n * k).reshape(n, k)
         dists = np.fromfile(f, dtype="<f4", count=n * k).reshape(n, k)
-    return ids, dists
+    return ids, -dists
 
 
 def load_gt_tsv(path: Path, k: int) -> tuple[np.ndarray, np.ndarray]:
@@ -58,7 +67,7 @@ def main() -> int:
     p.add_argument("--show-mismatches", type=int, default=5, help="Print first N mismatching queries")
     args = p.parse_args()
 
-    bin_ids, bin_dists = load_gt_bin(args.bin)
+    bin_ids, bin_scores = load_gt_bin(args.bin)
     n_bin, k = bin_ids.shape
     tsv_ids, tsv_scores = load_gt_tsv(args.tsv, k)
     n_tsv = tsv_ids.shape[0]
@@ -86,7 +95,7 @@ def main() -> int:
             # find rank of d in each list (cheap for small k)
             i = int(np.where(bin_ids[q] == d)[0][0])
             j = int(np.where(tsv_ids[q] == d)[0][0])
-            score_diffs.append(abs(float(bin_dists[q, i]) - float(tsv_scores[q, j])))
+            score_diffs.append(abs(float(bin_scores[q, i]) - float(tsv_scores[q, j])))
 
     print(f"queries compared: {n}  topk={k}")
     print(f"exact set match: {exact}/{n} ({100.0*exact/n:.2f}%)")
@@ -102,7 +111,46 @@ def main() -> int:
             print(f"  q={q}")
             print(f"    bin ids: {a}")
             print(f"    tsv ids: {b}")
-    return 0 if exact == n else 1
+
+    # Exact agreement is the WRONG bar and demanding it fails a correct scan.
+    #
+    # Two correct exhaustive f32 scans that accumulate in different orders order equidistant
+    # documents differently, so a document sitting exactly on the rank-k boundary can go either
+    # way. The bar is therefore: every disagreement is a floating-point tie. On NQ (2026-09-14)
+    # 8 of 3452 queries disagreed, every one of them by a single document at rank 10, with the
+    # two candidates' scores agreeing to 0-4 ULP (worst relative gap 1.27e-7, f32 eps 1.19e-7) --
+    # a pass. What a lossy CSR encoding looks like instead is gaps orders of magnitude larger,
+    # and disagreements that are not confined to the boundary.
+    #
+    # RTOL is ~8 ULP of f32: loose enough for accumulation order, far too tight to absorb a real
+    # encoding error.
+    RTOL = 1e-6
+    untied = []
+    for q in range(n):
+        only_bin = set(map(int, bin_ids[q])) - set(map(int, tsv_ids[q]))
+        if not only_bin:
+            continue
+        only_tsv = set(map(int, tsv_ids[q])) - set(map(int, bin_ids[q]))
+        edge_bin = min(float(bin_scores[q, int(np.where(bin_ids[q] == d)[0][0])]) for d in only_bin)
+        edge_tsv = min(float(tsv_scores[q, int(np.where(tsv_ids[q] == d)[0][0])]) for d in only_tsv)
+        gap = abs(edge_bin - edge_tsv)
+        if gap > RTOL * max(abs(edge_bin), abs(edge_tsv)):
+            untied.append((q, edge_bin, edge_tsv, gap))
+
+    if exact == n:
+        print("\nGATE PASS: exact set match on every query.")
+        return 0
+    if not untied:
+        print(f"\nGATE PASS: {n - exact} of {n} queries disagree, and every disagreement is a "
+              f"floating-point tie at the rank-{k} boundary (rtol {RTOL:.0e}). This is the bar "
+              "PROTOCOL sets for the exhaustive gate, and the outcome is a disclosure in the "
+              "write-up, not an internal check.")
+        return 0
+    print(f"\nGATE FAIL: {len(untied)} queries disagree by more than a float tie. The CSR encoding "
+          "or the ground truth is wrong; do not run a grid against this.")
+    for q, sb, st, gap in untied[:args.show_mismatches]:
+        print(f"  q={q}  boundary bin={sb:.6f} tsv={st:.6f}  gap={gap:.3e}")
+    return 1
 
 
