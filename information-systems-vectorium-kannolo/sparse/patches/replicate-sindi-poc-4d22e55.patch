@@ -18,9 +18,16 @@ cd "$(dirname "$0")/vsag"
 # Roxanne0321/vsag, so the fix lives as a parent-repo patch, not in the
 # submodule pointer. cwd is vsag/ here, so the patch path is repo-root-relative.
 # git apply --check is the idempotency guard: succeeds only if not yet applied.
+# 0003 adds a pass marker after each of sindi_index_search's three passes and dumps the returned
+# ids. Upstream prints nothing between the passes and never exposes the ids, which makes the
+# binary unmeasurable under an external benchmark's rules: the passes cannot be timed from
+# outside the process, and accuracy could only come from its own self-reported recall. Both
+# additions are pure observability -- they sit outside every timed region and leave upstream's
+# own `qps` computed over exactly the interval it was before. NOT a tuning change.
 for PATCH in \
     ../patches/0001-generate_gt-int32-header.patch \
-    ../patches/0002-thread_pool-md5-bump.patch
+    ../patches/0002-thread_pool-md5-bump.patch \
+    ../patches/0003-sindi-search-pass-markers-and-ids-dump.patch
 do
     if git apply --check "${PATCH}" 2>/dev/null; then
         git apply "${PATCH}"
