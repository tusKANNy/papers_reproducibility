+// Per-query times (kANNolo/Vectorium journal campaign, benchmark-only, never upstreamed): with
+// QUERY_TIMES_DIR set, writes <dir>/<pid>.tsv holding the argv line and then one line per pass of
+// per-query nanoseconds. Written after the last pass, outside every timed region.
+fn qtimes_dump(times: &[Vec<u64>]) {
+    if let Ok(dir) = std::env::var("QUERY_TIMES_DIR") {
+        use std::io::Write as _;
+        let argv: Vec<String> = std::env::args().collect();
+        let path = format!("{}/{}.tsv", dir, std::process::id());
+        let mut f = std::fs::File::create(&path).expect("QUERY_TIMES_DIR");
+        writeln!(f, "# {}", argv.join(" ")).unwrap();
+        for (i, pass) in times.iter().enumerate() {
+            let s: Vec<String> = pass.iter().map(|t| t.to_string()).collect();
+            writeln!(f, "{}\t{}", i + 1, s.join(" ")).unwrap();
+        }
+    }
+}
