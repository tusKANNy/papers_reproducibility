diff --git a/vibe/algorithms/svs/module.py b/vibe/algorithms/svs/module.py
index 2ce9e23..6e522af 100644
--- a/vibe/algorithms/svs/module.py
+++ b/vibe/algorithms/svs/module.py
@@ -2,8 +2,45 @@ import numpy as np
 import svs
 import os
 import tempfile
+import time
 
 from ..base.module import BaseANN
+from ... import placement
+
+
+def _staging_dir():
+    """Where SVS stages its `.fvecs` copy of the training set.
+
+    Upstream hardcodes `os.getcwd()`, which is VIBE's own checkout. That is fine at VIBE's own
+    scale and fails hard at ours: the staging file is the *entire* training set, 36 GB at D1
+    (8 840 823 x 1024 f32) and 64 GB at D2, and /home has 29 GB free. Every one of D1's eight
+    LeanVec builds died with `OSError: [Errno 28] No space left on device` inside `write_vecs`,
+    which VIBE reports as a return code, not as a missing system -- so the arm silently produced
+    no results at all.
+
+    Unset, this returns upstream's behaviour byte for byte. `VIBE_SVS_TMPDIR` only moves the
+    scratch file; it changes no algorithm parameter.
+    """
+    return os.environ.get("VIBE_SVS_TMPDIR") or os.getcwd()
+
+
+def _write_staging(X, temp_filename):
+    """`svs.write_vecs`, timed and logged.
+
+    The write sits INSIDE `fit()`, and VIBE times the whole of `fit()` (`vibe/runner.py:245`),
+    so this I/O is counted as SVS build time. At 36 GB that is no longer negligible and it is a
+    property of the harness rather than of the library, so the cost is logged and can be
+    subtracted when SVS's build time is reported.
+    """
+    t0 = time.perf_counter()
+    svs.write_vecs(X, temp_filename)
+    dt = time.perf_counter() - t0
+    gib = X.nbytes / (1 << 30)
+    print(
+        f"[svs] staged {gib:.1f} GiB to {os.path.dirname(temp_filename) or '.'} in {dt:.1f}s "
+        f"({gib / dt:.2f} GiB/s) -- included in build_time",
+        flush=True,
+    )
 
 
